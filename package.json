{
  "name": "blankspace-tweet-card-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:sync": "node scripts/build-existing-materials.mjs",
    "data:high-exposure": "node scripts/build-crawled-high-exposure-materials.mjs && node scripts/build-existing-materials.mjs",
    "db:generate": "drizzle-kit generate",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "api:start": "node apps/api/dist/server.js",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs --username admin",
    "db:migrate": "node scripts/run-migrations.mjs",
    "data:migrate:manifest": "node scripts/build-server-migration-manifest.mjs",
    "data:migrate:dry": "node scripts/migrate-existing-data.mjs --dry-run",
    "data:migrate": "node scripts/migrate-existing-data.mjs",
    "test:server": "node --test tests/server/*.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
