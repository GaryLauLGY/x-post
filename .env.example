# PostgreSQL container password. Generate on the target host; never commit the value.
POSTGRES_PASSWORD=

# Host-side API connection. Keep the database bound to 127.0.0.1.
DATABASE_URL=postgresql://xpost:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:54329/xpost

# Comma-separated exact browser origins. Leave empty while the API is private.
XPOST_CORS_ORIGINS=

# Administrator and internal-import authentication are intentionally disabled in milestone A.
XPOST_OIDC_ISSUER=
XPOST_OIDC_CLIENT_ID=
XPOST_ADMIN_EMAIL_ALLOWLIST=
XPOST_IMPORT_TOKEN=
