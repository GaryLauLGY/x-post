# PostgreSQL container password. Generate on the target host; never commit the value.
POSTGRES_PASSWORD=

# Host-side API connection. Keep the database bound to 127.0.0.1.
DATABASE_URL=postgresql://xpost:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:54329/xpost

# Exact public browser origin used for Origin and CSRF validation.
XPOST_PUBLIC_ORIGIN=https://xpost.garylau.ai

# Local administrator sessions. The password hash is stored in PostgreSQL.
XPOST_SESSION_TTL_HOURS=12

# Internal crawler import credential. Generate on the target; never commit the value.
XPOST_IMPORT_TOKEN=
