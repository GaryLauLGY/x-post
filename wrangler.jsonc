{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-post",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "xpost.garylau.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "XPOST_API_ORIGIN": "https://xpost-origin.garylau.ai/"
  },
  "observability": {
    "enabled": true
  }
}
